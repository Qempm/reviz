# Dépendances
node_modules/

# Next.js
/.next/
/out/
next-env.d.ts

# Build
/build/
/dist/

# Environnement — jamais de clé dans le dépôt
.env
.env.local
.env*.local

# Vercel
.vercel

# TypeScript
*.tsbuildinfo

# Tests
/coverage/

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# OS
.DS_Store
Thumbs.db

# Éditeurs
/.idea/
*.iml
.vscode/*
!.vscode/extensions.json

# Claude Code — réglages locaux à la machine (launch.json est partagé)
.claude/settings.local.json

# Supabase — état local de la liaison, propre à la machine
supabase/.temp/
supabase/.branches/
# Vercel a posé « .env* », trop large : il avalerait .env.example, qui doit
# rester versionné comme gabarit.
.env*
!.env.example

# Rapport JSON de Vitest, écrit à chaque exécution.
.vitest/

# Binaires de l'application.
#
# Un APK versionné alourdit l'historique git **définitivement** : chaque
# reconstruction y ajoute deux mégaoctets et demi que rien ne retire.
# `public/reviz-1.0.0.apk` est retiré du suivi — ce qui ne le retire pas du
# passé : la réécriture d'historique a été écartée sur un dépôt dont l'accès
# en écriture est déjà problématique. L'APK signé du lot C se publiera en
# release GitHub, pas ici.
*.apk
*.aab

# Clés de signature Android. Une clé engagée est une clé à révoquer, et rien
# ne les couvrait avant le lot C.
*.jks
*.keystore
**/key.properties
