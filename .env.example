# App URL (pour les redirects FedaPay et les tokens)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Supabase — https://supabase.com/dashboard/project/_/settings/api
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Clé de service : serveur uniquement, jamais exposée au client.
SUPABASE_SERVICE_ROLE_KEY=

# IA — voir docs/STACK-IA.md
DEEPSEEK_API_KEY=
DASHSCOPE_API_KEY=
ZAI_API_KEY=

# Paiement Mobile Money (FedaPay)
FEDAPAY_SECRET_KEY=
FEDAPAY_WEBHOOK_SECRET=

# Notifications WhatsApp via n8n
N8N_WHATSAPP_WEBHOOK_URL=

# Secret partagé protégeant /api/jobs/run (Vercel Cron)
CRON_SECRET=

# Push (Firebase) — docs/GUIDE-NOTIFICATIONS.md. Facultatif : sans lui,
# le centre de notifications et les rappels marchent, seul le push manque.
# SECRET : le JSON du compte de service, en base64. Jamais NEXT_PUBLIC_.
FIREBASE_SERVICE_ACCOUNT=
# Identifiants publics du projet, compilés dans l'APK par `npm run apk`.
FIREBASE_PROJECT_ID=
FIREBASE_SENDER_ID=
FIREBASE_ANDROID_API_KEY=
FIREBASE_ANDROID_APP_ID=

# --- Compilation de l'APK (npm run apk) ------------------------------------
#
# Ces deux valeurs ne servent pas au serveur : elles sont injectées dans
# l'application Flutter au build (`--dart-define`). Sans API_BASE, l'APK
# démarre sur un bandeau « configuration absente ».
#
# L'URL et la clé anonyme de Supabase sont reprises des variables ci-dessus :
# ce sont les seules valeurs qu'un APK peut embarquer, puisqu'il se décompile.

# Origine des routes Next.js déployées, sans barre finale.
API_BASE=https://revizapp.fun
# Client OAuth **Web** de Google. Facultatif : sans lui le bouton Google
# reste désactivé, la connexion par code e-mail fonctionne.
GOOGLE_WEB_CLIENT_ID=
# Numéro WhatsApp du support, format international sans « + » ni espace
# (ex. 22990000000). Facultatif : sans lui, l'écran d'aide n'affiche pas de
# contact plutôt que d'ouvrir un numéro qui ne répond pas.
CONTACT_WHATSAPP=
# Chemin du binaire Flutter, si son dossier `bin` n'est pas dans le PATH —
# le cas quand Flutter est installé par Android Studio. `npm run apk` cherche
# d'abord ici, puis dans le PATH, puis aux endroits habituels.
FLUTTER_BIN=
